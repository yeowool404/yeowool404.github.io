{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "yeowool404.github.io page content",
    "type": "object",
    "required": ["name", "tagline", "links", "discography"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "name": { "type": "string", "description": "Page heading." },
        "tagline": { "type": "string", "description": "Line under the heading." },
        "links": {
            "type": "array",
            "description": "One row per entry: an icon followed by its links.",
            "items": {
                "type": "object",
                "required": ["icon", "items"],
                "additionalProperties": false,
                "properties": {
                    "icon": { "type": "string" },
                    "items": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/definitions/link" }
                    }
                }
            }
        },
        "discography": {
            "type": "array",
            "description": "Releases, newest first. Grouped under a heading per year.",
            "items": { "$ref": "#/definitions/release" }
        }
    },
    "definitions": {
        "link": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string" },
                "url": { "type": "string", "format": "uri" }
            }
        },
        "release": {
            "type": "object",
            "required": ["year", "emoji", "title", "url", "artwork"],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$",
                    "description": "Anchor for linking straight to this release (yeowool.ing/#id)."
                },
                "year": { "type": "integer", "minimum": 2000 },
                "emoji": { "type": "string" },
                "title": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "artwork": { "type": "string", "description": "Image path relative to the site root, e.g. assets/foo.jpg." },
                "notes": {
                    "type": "array",
                    "description": "Lines under the title. [text](url) becomes a link.",
                    "items": { "type": "string" }
                }
            }
        }
    }
}
